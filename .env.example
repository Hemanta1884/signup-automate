# Copy this file to `.env` and adjust values if needed.
# No credentials are required for the public signup flow under test.

# Application under test
BASE_URL=https://authorized-partner.vercel.app

# Backend API used by the application (read-only reference for debugging)
API_BASE=https://stage.cloudedu.com.au/api

# OTP e-mail retrieval (public Mailinator inbox - no account/API key needed)
OTP_INBOX_URL=https://www.mailinator.com/v4/public/inboxes.jsp?to=
OTP_SUBJECT=Signup Confirm OTP
OTP_TIMEOUT_MS=90000

# Optional: set to 1 to watch the run in a real browser window
HEADFUL=0

# Optional: skip e-mail lookup by supplying the code manually (debug only)
# OTP_CODE=
